# ============================================================================
# Hello-Agents 学习环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制到 learning-plan/.env 后填入真实值
#   cp learning-plan/.env.example learning-plan/.env
# 注意：.env 已在 .gitignore，不会被提交
# ============================================================================

# --- 主用 LLM（scnet Qwen3）---
LLM_MODEL_ID=Qwen3-235B-A22B
LLM_API_KEY=请在此填入真实 key
LLM_BASE_URL=https://api.scnet.cn/api/llm/v1

# --- 可选：Tavily 搜索（Week 3 才会用到）---
# TAVILY_API_KEY=

# --- 可选：LangSmith Tracing（Week 3）---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=hello-agents-learning
